[resource]
script = ExtResource("1")
engagement_profile = ExtResource("rules")
scenario_id = &"mission_3_false_echoes"
display_name = "Mission 3 – Falsche Echos"
summary = "Unterscheiden Sie unsichere Echos anhand von Messkonsistenz, Sensorabstützung und Geländeabdeckung."
campaign_order = 3
unlock_requires = PackedStringArray("tutorial_mission_2")
expected_duration_minutes = 15
learning_objectives = PackedStringArray("Geländeabschattung erkennen", "Messindizien vergleichen", "Auffällige Tracks bewusst sperren")
briefing = "Im Westsektor treten Interferenzen und unbeständige Echos auf. Schützen Sie Kommandozentrum und mindestens ein weiteres Schutzgut. Ein Fragezeichen zeigt einen Verdacht, keine Gewissheit. Vergleichen Sie Sensoren und Messverläufe vor einer Freigabe."
briefing_sections = Array[Dictionary]([{
"id": &"mission", "title": "Auftrag", "body": "Halten Sie das Kommandozentrum und mindestens ein weiteres Schutzgut bis T+06:00."
}, {
"id": &"terrain", "title": "Gelände und Störung", "body": "Der westliche Höhenzug schwächt tiefe Sichtlinien. Prüfen Sie die Geländeebene und die Reichweitenvorschau. Kurzstreckensensoren sind in der westlichen Interferenzzone besonders betroffen. Unterschiedliche Sensorarten und Standorte liefern Vergleichsmessungen."
}, {
"id": &"evidence", "title": "Unsicherheit bewerten", "body": "Ein Fragezeichen bedeutet mögliche Täuschung. Prüfen Sie Konsistenz, Interferenz und Sensorabstützung. Sperren Sie einen auffälligen Track bei Bedarf und beobachten Sie ihn weiter. Jede voreilige Freigabe kann begrenzte Munition verbrauchen. Keine Farbe verrät die verborgene Wahrheit."
}])
victory_debriefing = "Der Schutzauftrag wurde erfüllt. Vergleichen Sie Netzausfälle, Interferenzverlauf und Munitionsverbrauch. Ein zweiter Sensorstandort oder das bewusste Sperren inkonsistenter Kontakte kann wichtiger sein als ein weiteres Abwehrsystem."
defeat_debriefing = "Der Schutzauftrag wurde verfehlt. Vergleichen Sie den westlichen Höhenzug und die Interferenzzone mit Ihren Sensorstandorten. Ein Trackverdacht ist ein Indiz: Beobachten, unabhängig abstützen und erst dann über Sperre oder Freigabe entscheiden."
world_size = Vector2(2000, 1200)
starting_budget = 3000
seed = 20260914
mission_duration = 360.0
definitions = Array[Resource]([ExtResource("2"), ExtResource("3"), ExtResource("4"), ExtResource("5"), ExtResource("6"), ExtResource("7"), ExtResource("8"), ExtResource("9"), ExtResource("10"), ExtResource("11"), ExtResource("12")])
