[gd_resource type="Resource" script_class="ScenarioDefinition" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/core/scenario_definition.gd" id="1"]
[ext_resource type="Resource" path="res://data/tutorial/sensor_tutorial_early_warning.tres" id="2"]
[ext_resource type="Resource" path="res://data/tutorial/defense_tutorial_short_range.tres" id="3"]
[ext_resource type="Resource" path="res://data/tutorial/threat_tutorial_contact.tres" id="4"]
[ext_resource type="Resource" path="res://data/infrastructure/infrastructure_power.tres" id="5"]
[ext_resource type="Resource" path="res://data/scenarios/tutorial_mission_1_wave.tres" id="6"]

[ext_resource type="Resource" path="res://data/rules/standard.tres" id="rules"]

[resource]
script = ExtResource("1")
engagement_profile = ExtResource("rules")
scenario_id = &"tutorial_mission_1"
display_name = "Tutorial Mission 1 – Erste Wachschicht"
summary = "Bauen Sie ein erstes Sensornetz auf und schützen Sie ein Kraftwerk vor einem klar erkennbaren Kontakt."
campaign_order = 1
expected_duration_minutes = 10
learning_objectives = PackedStringArray("Sensor und Abwehr platzieren", "Tracks lesen", "Simulationszeit steuern")
briefing = "Willkommen in der Wachschicht. Ein einzelner, deutlich erfassbarer Übungskontakt wird das Kraftwerk anfliegen. Bauen Sie ein einfaches Sensornetz und sichern Sie das Ziel mit einem Kurzstreckensystem. Der Kontakt wird automatisch bekämpft, sobald er ausreichend klassifiziert und in Reichweite ist; ein direkter Schussbefehl ist nicht nötig."
briefing_sections = Array[Dictionary]([{
"body": "Schützen Sie das Kraftwerk bis zum Ende der Übung.",
"id": &"mission",
"title": "Auftrag"
}, {
"body": "Das Kraftwerk ist das einzige Schutzgut und muss erhalten bleiben.",
"id": &"assets",
"title": "Schutzgut"
}, {
"body": "Das Budget reicht für einen Frühwarnsensor und ein Kurzstreckensystem. Der Kontakt wird nach sicherer Klassifikation automatisch bekämpft.",
"id": &"constraints",
"title": "Einschränkungen und neue Mechanik"
}])
victory_debriefing = "Das Kraftwerk blieb betriebsbereit. Sensorabdeckung und Abwehrreichweite waren ausreichend aufeinander abgestimmt."
defeat_debriefing = "Das Kraftwerk wurde nicht gehalten. Prüfen Sie im nächsten Versuch besonders die Überlappung von Sensor- und Abwehrreichweite."
world_size = Vector2(2000, 1200)
starting_budget = 1200
seed = 10101
mission_duration = 30.0
definitions = Array[Resource]([ExtResource("2"), ExtResource("3"), ExtResource("4"), ExtResource("5")])
starting_entities = Array[Dictionary]([{
"definition_id": &"infrastructure_power",
"faction": &"player",
"id": &"tutorial_power",
"position": Vector2(1000, 600)
}])
attack_waves = Array[Resource]([ExtResource("6")])
placement_zones = Array[Rect2]([Rect2(850, 430, 300, 340)])
blocked_zones = Array[Rect2]([Rect2(950, 550, 100, 100)])
mission_goals = {
"minimum_survivors": 1,
"required_survivors": PackedStringArray("tutorial_power")
}
tutorial_steps = Array[Dictionary]([{
"id": &"read_briefing",
"instruction": "Lesen Sie das Einsatzbriefing und wählen Sie dann ‚Wachschicht beginnen‘.",
"title": "Einsatzauftrag lesen",
"trigger": &"briefing_closed"
}, {
"definition_id": &"sensor_early_warning",
"id": &"select_sensor",
"instruction": "Wählen Sie links im Systemkatalog den Frühwarnsensor aus.",
"title": "Frühwarnsensor auswählen",
"trigger": &"definition_selected"
}, {
"definition_id": &"sensor_early_warning",
"id": &"place_sensor",
"instruction": "Platzieren Sie den Sensor in der grün umrandeten Zone. Seine Vorschau zeigt die Erfassungsreichweite.",
"title": "Sensor aufstellen",
"trigger": &"system_placed"
}, {
"definition_id": &"defense_short_range",
"id": &"select_defense",
"instruction": "Wählen Sie jetzt das Kurzstreckensystem aus.",
"title": "Abwehr auswählen",
"trigger": &"definition_selected"
}, {
"definition_id": &"defense_short_range",
"id": &"place_defense",
"instruction": "Stellen Sie die Abwehr nahe beim Kraftwerk auf. Der grüne Reichweitenkreis muss den Anflugweg abdecken. Halten Sie Abstand zum bereits platzierten Sensor.",
"title": "Objektschutz aufbauen",
"trigger": &"system_placed"
}, {
"id": &"start_mission",
"instruction": "Ihr Aufbau ist einsatzbereit. Wählen Sie links ‚Einsatz starten‘.",
"title": "Wachschicht starten",
"trigger": &"mission_started"
}, {
"id": &"detect_track",
"instruction": "Beobachten Sie den Radarschirm. Sobald der Sensor misst, entsteht ein Track aus geschätzter Position und Unsicherheit.",
"pause_on_complete": true,
"title": "Kontakt erfassen",
"trigger": &"track_detected"
}, {
"id": &"inspect_track",
"instruction": "Die Zeit wurde angehalten. Klicken Sie den Track an und prüfen Sie Klassifikation, Konfidenz und Unsicherheit rechts.",
"object_kind": &"track",
"title": "Track untersuchen",
"trigger": &"track_selected"
}, {
"id": &"resume_simulation",
"instruction": "Starten Sie die Zeit zunächst mit 1×. Sie müssen nicht auf den Kontakt schießen: Die automatische Freigabe weist ihn zu, sobald Klassifikation, Reichweite und Bereitschaft ausreichen.",
"minimum_scale": 1.0,
"title": "Abwehr beobachten",
"trigger": &"simulation_resumed"
}, {
"id": &"finish_mission",
"instruction": "Schützen Sie das Kraftwerk bis T+00:30. Danach erscheint Ihre Missionsauswertung.",
"title": "Mission abschließen",
"trigger": &"mission_finished"
}])
