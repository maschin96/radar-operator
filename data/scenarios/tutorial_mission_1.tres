[gd_resource type="Resource" script_class="ScenarioDefinition" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/core/scenario_definition.gd" id="1"]
[ext_resource type="Resource" path="res://data/sensors/sensor_early_warning.tres" id="2"]
[ext_resource type="Resource" path="res://data/defenses/defense_short_range.tres" id="3"]
[ext_resource type="Resource" path="res://data/threats/threat_swift.tres" id="4"]
[ext_resource type="Resource" path="res://data/infrastructure/infrastructure_power.tres" id="5"]
[ext_resource type="Resource" path="res://data/scenarios/tutorial_mission_1_wave.tres" id="6"]

[resource]
script = ExtResource("1")
scenario_id = &"tutorial_mission_1"
display_name = "Tutorial Mission 1 – Erste Wachschicht"
briefing = "Willkommen in der Wachschicht. Ein einzelner, deutlich erfassbarer Kontakt wird das Kraftwerk anfliegen. Bauen Sie ein einfaches Sensornetz und sichern Sie das Ziel mit einem Kurzstreckensystem. Die Einsatzleitung begleitet jeden Schritt."
world_size = Vector2(2000, 1200)
starting_budget = 1200
seed = 10101
mission_duration = 30.0
definitions = Array[Resource]([ExtResource("2"), ExtResource("3"), ExtResource("4"), ExtResource("5")])
starting_entities = Array[Dictionary]([{
"definition_id": &"infrastructure_power",
"faction": &"player",
"id": &"tutorial_power",
"position": Vector2(1000, 600)
}])
attack_waves = Array[Resource]([ExtResource("6")])
placement_zones = Array[Rect2]([Rect2(850, 430, 300, 340)])
blocked_zones = Array[Rect2]([Rect2(950, 550, 100, 100)])
mission_goals = {
"minimum_survivors": 1,
"required_survivors": PackedStringArray("tutorial_power")
}
tutorial_steps = Array[Dictionary]([{
"id": &"read_briefing",
"instruction": "Lesen Sie das Einsatzbriefing und wählen Sie dann ‚Wachschicht beginnen‘.",
"title": "Einsatzauftrag lesen",
"trigger": &"briefing_closed"
}, {
"definition_id": &"sensor_early_warning",
"id": &"select_sensor",
"instruction": "Wählen Sie links im Systemkatalog den Frühwarnsensor aus.",
"title": "Frühwarnsensor auswählen",
"trigger": &"definition_selected"
}, {
"definition_id": &"sensor_early_warning",
"id": &"place_sensor",
"instruction": "Platzieren Sie den Sensor in der grün umrandeten Zone. Seine Vorschau zeigt die Erfassungsreichweite.",
"title": "Sensor aufstellen",
"trigger": &"system_placed"
}, {
"definition_id": &"defense_short_range",
"id": &"select_defense",
"instruction": "Wählen Sie jetzt das Kurzstreckensystem aus.",
"title": "Abwehr auswählen",
"trigger": &"definition_selected"
}, {
"definition_id": &"defense_short_range",
"id": &"place_defense",
"instruction": "Stellen Sie die Abwehr nahe beim Kraftwerk auf. Halten Sie Abstand zum bereits platzierten Sensor.",
"title": "Objektschutz aufbauen",
"trigger": &"system_placed"
}, {
"id": &"start_mission",
"instruction": "Ihr Aufbau ist einsatzbereit. Wählen Sie links ‚Einsatz starten‘.",
"title": "Wachschicht starten",
"trigger": &"mission_started"
}, {
"id": &"detect_track",
"instruction": "Beobachten Sie den Radarschirm. Sobald der Sensor misst, entsteht ein Track aus geschätzter Position und Unsicherheit.",
"pause_on_complete": true,
"title": "Kontakt erfassen",
"trigger": &"track_detected"
}, {
"id": &"inspect_track",
"instruction": "Die Zeit wurde angehalten. Klicken Sie den Track an und prüfen Sie Klassifikation, Konfidenz und Unsicherheit rechts.",
"object_kind": &"track",
"title": "Track untersuchen",
"trigger": &"track_selected"
}, {
"id": &"resume_simulation",
"instruction": "Starten Sie die Zeit mit 1×, 2× oder 4×. Die automatische Freigabe übernimmt ausreichend klassifizierte Ziele.",
"minimum_scale": 1.0,
"title": "Abwehr beobachten",
"trigger": &"simulation_resumed"
}, {
"id": &"finish_mission",
"instruction": "Schützen Sie das Kraftwerk bis T+00:30. Danach erscheint Ihre Missionsauswertung.",
"title": "Mission abschließen",
"trigger": &"mission_finished"
}])
