[ext_resource type="Resource" path="res://data/rules/standard.tres" id="rules"]

[resource]
script = ExtResource("1")
engagement_profile = ExtResource("rules")
scenario_id = &"mission_4_saturation"
display_name = "Mission 4 – Sättigung · Herausforderung"
summary = "Halten Sie die Versorgung gegen mehrere Anfluggruppen und verlegen Sie eine begrenzte mobile Reserve."
campaign_order = 4
unlock_requires = PackedStringArray("mission_3_false_echoes")
expected_duration_minutes = 15
learning_objectives = PackedStringArray("Sensorabdeckung planen", "Mehrere Schutzgüter priorisieren", "Missionsauswertung interpretieren")
briefing = "Das Finale kombiniert vertraute Systeme. Zuerst geraten Kraftwerk und Kommandozentrum unter Druck, danach der Ostsektor. Munition ist begrenzt. Eine mobile Reserve kann während der ruhigen Übergangsphase verlegt werden."
briefing_sections = Array[Dictionary]([{
"id": &"mission", "title": "Auftrag", "body": "Halten Sie das Kommandozentrum und mindestens ein weiteres Schutzgut bis T+07:00. Drei Gruppen wechseln die belastete Angriffsachse."
}, {
"id": &"phases", "title": "Phasen", "body": "T+30 bis T+105: West und Zentrum. Ab T+180: verdichtete Ostanflüge. Ab T+290: gemischte Abschlussgruppe. Lagehinweise kündigen Übergänge an; die Zeit kann angehalten werden."
}, {
"id": &"reserve", "title": "Mobile Reserve und Munition", "body": "Die mobile Reserve wird wie die bekannten mobilen Systeme verlegt: auswählen, Ziel wählen, Route prüfen. Während Abbau, Fahrt und Aufbau wirkt sie nicht. Verlegen kostet 35 Budget. Prüfen Sie Restmunition und Freigaben, bevor die nächste Gruppe beginnt. Standard bietet 4000 Budget, Herausforderung 3400."
}])
victory_debriefing = "Die Kampagne ist abgeschlossen. Die Auswertung zeigt verbrauchte Munition, Verlegungen und Netzausfälle. Vergleichen Sie breite Anfangsabdeckung mit einer beweglichen Reserve für den Wechsel der Angriffsachse."
defeat_debriefing = "Die Sättigung hat den Schutzauftrag durchbrochen. Prüfen Sie Restmunition, Versorgungsquellen und Verlegezeitpunkt. Eine Reserve während der Angriffsspitze abzubauen öffnet vorübergehend eine Lücke; eine frühzeitige Verlegung kann die nächste Achse abfangen."
world_size = Vector2(2000, 1200)
starting_budget = 3400
seed = 20260915
mission_duration = 420.0
definitions = Array[Resource]([ExtResource("2"), ExtResource("3"), ExtResource("4"), ExtResource("5"), ExtResource("6"), ExtResource("7"), ExtResource("8"), ExtResource("9"), ExtResource("10"), ExtResource("11"), ExtResource("12")])
starting_entities = Array[Dictionary]([{
"definition_id": &"infrastructure_command",
"faction": &"player",
"id": &"capital_command",
"position": Vector2(1000, 610)
}, {
"definition_id": &"infrastructure_power",
"faction": &"player",
"id": &"north_power",
"position": Vector2(520, 390)
}, {
"definition_id": &"infrastructure_factory",
"faction": &"player",
"id": &"east_factory",
"position": Vector2(1510, 790)
}])
attack_waves = Array[Resource]([ExtResource("13")])
placement_zones = Array[Rect2]([Rect2(80, 80, 1840, 1040)])
blocked_zones = Array[Rect2]([Rect2(940, 550, 120, 120), Rect2(470, 340, 100, 100), Rect2(1460, 740, 100, 100)])
network_connections = Array[Dictionary]([{
"consumer_id": &"capital_command",
"id": &"energy_power_command",
"kind": &"energy",
"reserve_duration": 10.0,
"source_id": &"north_power"
}, {
"consumer_id": &"east_factory",
"id": &"energy_power_factory",
"kind": &"energy",
"reserve_duration": 5.0,
"source_id": &"north_power"
}, {
"consumer_id": &"north_power",
"id": &"communication_command_power",
"kind": &"communication",
"reserve_duration": 6.0,
"source_id": &"capital_command"
}, {
"consumer_id": &"east_factory",
"id": &"communication_command_factory",
"kind": &"communication",
"reserve_duration": 4.0,
"source_id": &"capital_command"
}])
mission_goals = {
"minimum_survivors": 2,
"required_survivors": PackedStringArray("capital_command")
}
mission_events = Array[Dictionary]([{
"time": 1.0, "message": "LAGE: West- und Zentrumsgruppe erwartet. Munition reicht nur bei überlegter Verteilung."
}, {
"time": 130.0, "message": "LAGEWECHSEL: Ostanflüge ab T+180. Jetzt besteht Zeit, eine mobile Reserve mit sicherem Ziel und ausreichendem Restbudget zu verlegen."
}, {
"time": 175.0, "message": "LAGE: Ostanflüge in fünf Sekunden. Abbau und Fahrt sperren ein System; prüfen Sie Bereitschaft und Restmunition."
}, {
"time": 280.0, "message": "LAGEWECHSEL: Gemischte Abschlussgruppe. Überprüfen Sie Sperren, Prioritäten und die Versorgung des Kommandozentrums."
}])
